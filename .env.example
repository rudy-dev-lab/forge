# ─── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_secret
POSTGRES_DB=forge_db

# ─── Redis (Semaine 3+) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Pipeline defaults ─────────────────────────────────────────
PIPELINE_BATCH_SIZE=500
PIPELINE_MAX_RETRIES=3
PIPELINE_TIMEOUT_MS=30000
